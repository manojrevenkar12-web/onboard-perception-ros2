<?xml version="1.0"?>
<package format="3">
  <name>opr_shm_transport</name>
  <version>0.1.0</version>
  <description>image_transport "shm" plugin and a dual raw/shared-memory publisher for leased shared-memory images.</description>
  <maintainer email="manojrevenkar70@gmail.com">Manoj Kumar Prakash</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <depend>pluginlib</depend>
  <depend>opr_msgs</depend>
  <depend>opr_shm</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <image_transport plugin="${prefix}/plugins.xml"/>
  </export>
</package>
